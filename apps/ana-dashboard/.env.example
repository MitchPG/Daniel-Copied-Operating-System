# ── Ana's Dashboard / Helm — environment variables ──
# Set these in Vercel: Project Settings -> Environment Variables.
# Never commit real values.

# Notion internal integration token (starts with "ntn_" or "secret_").
# Create at https://www.notion.so/profile/integrations, then share the
# "Task Hub" database with the integration (••• -> Connections -> add it).
NOTION_TOKEN=

# Access code the dashboard asks for on first load. Pick something private
# and share it only with the people who should see the Task Hub.
APP_PASSCODE=

# Optional overrides (sensible defaults are baked in):
# Data source (collection) ID of the Task Hub. Default is the current one.
NOTION_DATA_SOURCE_ID=37f25735-7460-406e-9784-b6d9270a7cd8
# Default owner shown when the dashboard loads.
OWNER_NAME=Ana
